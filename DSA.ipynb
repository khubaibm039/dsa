   "source": [
    "### fibonacci using for loop"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "572feb40",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "The 20th Fibonacci is : 8\n"
     ]
    }
   ],
   "source": [
    "n = int(input(\"please enter more than 2: \"))\n",
    "first_fib = 0\n",
    "second_fib = 1\n",
    "new_fib = 0\n",
    "\n",
    "for i in range(n-2):\n",
    "    new_fib = second_fib + first_fib\n",
    "    first_fib = second_fib\n",
    "    second_fib = new_fib\n",
    "print('The 20th Fibonacci is :', new_fib)"
   ]
  },
